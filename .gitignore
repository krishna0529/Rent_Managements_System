# ==========================================
# Root .gitignore for Rent Management System
# ==========================================

# Java / Maven build artifacts
**/target/
**/*.jar
**/*.war
**/*.class
**/.mvn/
**/mvnw
**/mvnw.cmd

# Node / Next.js artifacts
**/node_modules/
**/.next/
**/out/
**/build/
**/dist/
**/.pnp
**/.pnp.js

# Environment and Secret files
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# Uploaded media and temporary files
**/uploads/
**/tmp/
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# IDE and Editor files
**/.idea/
**/.vscode/
**/*.iml
**/*.iws
**/*.ipr
**/.project
**/.classpath
**/.settings/
**/.DS_Store
Thumbs.db
